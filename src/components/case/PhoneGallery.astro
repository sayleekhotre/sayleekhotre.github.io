---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  img: ImageMetadata;
  caption: string;
  tag?: string;
}

interface Props {
  items: Item[];
  callouts?: boolean; // render captions as dashed annotation callouts
  cols?: number; // max columns on desktop
}

const { items, callouts = false, cols } = Astro.props;
---

<ul class={`gallery${callouts ? ' has-callouts' : ''}`} style={cols ? `--cols:${cols}` : undefined}>
  {
    items.map((it) => (
      <li>
        <figure>
          <div class="phone">
            <Image src={it.img} alt={it.caption} widths={[320, 640]} sizes="(max-width: 860px) 60vw, 260px" loading="lazy" />
          </div>
          <figcaption class={callouts ? 'callout' : undefined}>
            {it.tag && <span class="gallery-tag">{it.tag}</span>}
            {it.caption}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
