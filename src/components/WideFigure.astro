---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
---

<figure class="figure">
  <div class="figure-frame">
    <Image src={src} alt={alt} widths={[800, 1400, 2000]} sizes="(max-width: 1240px) 100vw, 1180px" loading={priority ? 'eager' : 'lazy'} />
  </div>
  {
    caption && (
      <figcaption>
        <span class="figcaption-index">Fig.</span> {caption}
      </figcaption>
    )
  }
</figure>
