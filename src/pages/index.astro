---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');

const roles = ['Enterprise UX', 'Design Systems', 'Interaction Design', 'User Research'];

const marquee = ['Product strategy', 'Interaction design', 'Design systems', 'User research', 'Prototyping', 'B2B SaaS', 'Mobile & web'];

// TODO: replace with Saylee's real numbers before shipping.
const stats = [
  { value: work.length, suffix: '', label: 'Case studies' },
  { value: 2, suffix: '', label: 'In-house roles' },
  { value: 2, suffix: '', label: 'Platforms — web & mobile' },
  { value: 100, suffix: '%', label: 'Figma-native workflow' },
];

const capabilities = [
  {
    title: 'Practice',
    note: 'How I work',
    items: ['Product strategy', 'Interaction design', 'Design systems', 'User research', 'Prototyping', 'Usability testing'],
  },
  {
    title: 'Tools',
    note: 'What I work in',
    items: ['Figma', 'FigJam', 'Maze', 'Notion', 'Linear'],
  },
  {
    title: 'Domains',
    note: 'Where I have shipped',
    items: ['Enterprise & B2B SaaS', 'Healthcare', 'Wellness', 'E-commerce', 'IT services'],
  },
];

const experience = [
  { role: 'Freelance UI/UX & Graphic Designer', org: 'Independent', dates: 'Present', note: 'Product and brand work for early-stage teams.' },
  { role: 'Digital Product Designer', org: 'Stellarview', dates: 'TODO — dates', note: 'TODO — one line on scope and impact.' },
  { role: 'UI/UX Designer', org: 'Assimilate Technologies', dates: 'TODO — dates', note: 'Website UX and UI redesign for an AI, infrastructure and cybersecurity services company.' },
];

const education = [{ credential: 'TODO — degree', org: 'TODO — institution', dates: 'TODO — dates', note: '' }];

const contacts = [
  { label: 'Email', value: 'TODO@example.com', href: 'mailto:TODO@example.com' },
  { label: 'LinkedIn', value: 'in/TODO', href: 'https://linkedin.com/in/TODO' },
  { label: 'Behance', value: 'behance.net/TODO', href: 'https://behance.net/TODO' },
];
---

<Layout
  title="Saylee Khotre — Senior Product Designer"
  description="Saylee Khotre designs enterprise software for B2B SaaS teams — permissions, workflows, and dense data made legible."
  home
>
  <main id="main">
    <!-- ============================== HERO ============================== -->
    <section id="hero" class="hero" aria-label="Introduction">
      <div class="hero-bg" aria-hidden="true">
        <div class="blob blob-a"></div>
        <div class="blob blob-b"></div>
        <div class="blob blob-c"></div>
        <div class="horizon"></div>
        <div class="grid-floor"><div class="grid-plane"></div></div>
        <svg class="orbits" viewBox="0 0 600 600" fill="none">
          <circle cx="300" cy="300" r="220" class="orbit o1" />
          <circle cx="300" cy="300" r="280" class="orbit o2" />
          <g class="orbit-spin s1"><circle cx="520" cy="300" r="3.5" class="sat" /></g>
          <g class="orbit-spin s2"><circle cx="300" cy="20" r="2.5" class="sat" /></g>
        </svg>
      </div>

      <div class="wrap hero-inner">
        <p class="hero-tag hero-step" data-step="0">
          <span class="pulse" aria-hidden="true"></span>
          Available for freelance &amp; full-time
        </p>

        <h1 class="hero-title">
          <span class="hero-first" data-split>Saylee</span>
          <span class="line-mask hero-last"><span class="grad">Khotre</span></span>
        </h1>

        <p class="hero-role hero-step" data-step="2">
          <span>Senior Product Designer</span>
          <span class="slash" aria-hidden="true">/</span>
          <span class="rotator" data-rotator aria-label={roles.join(', ')}>
            {roles.map((r, i) => <span class={i === 0 ? 'is-on' : ''} aria-hidden="true">{r}</span>)}
          </span>
        </p>

        <p class="hero-lede hero-step" data-step="3">
          I design enterprise software people can actually use — turning permission-heavy,
          data-dense workflows into interfaces that feel obvious in hindsight.
        </p>

        <div class="hero-actions hero-step" data-step="4">
          <a href="#work" class="btn btn-primary" data-magnetic>
            <span class="btn-label">View my work
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2v12M3 9l5 5 5-5" /></svg>
            </span>
          </a>
          <a href="#contact" class="btn btn-ghost" data-magnetic><span class="btn-label">Get in touch</span></a>
        </div>
      </div>

      <div class="wrap hero-foot hero-step" data-step="5">
        <a href="#about" class="scroll-cue" aria-label="Scroll to about">
          <span class="scroll-line" aria-hidden="true"></span>
          <span class="mono">Scroll</span>
        </a>
        <p class="mono hero-meta">Pune, IN <span class="sep">·</span> <span data-clock>--:--</span> IST</p>
      </div>
    </section>

    <!-- ============================== MARQUEE ============================== -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {marquee.map((m) => (
              <span class="marquee-item">{m}<span class="spark">✦</span></span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- ============================== ABOUT ============================== -->
    <section id="about" class="section">
      <div class="wrap about-grid">
        <div class="about-copy">
          <p class="label reveal"><span class="idx">01</span>About</p>
          <h2 class="display reveal" data-d="80">Designing clarity into <em>complex systems.</em></h2>
          <div class="about-body reveal" data-d="160">
            <p>
              I spend most of my time in enterprise software — the kind with permission models,
              audit trails, and a hundred edge cases that never make it into a demo. I care about
              the gap between a flow that looks clean in <strong>Figma</strong> and one that survives
              contact with a real admin console.
            </p>
            <p>
              I'm based in Pune, India, working as a freelance UI/UX and graphic designer, with
              in-house experience as a Digital Product Designer at <strong>Stellarview</strong> and a
              UI/UX Designer at <strong>Assimilate Technologies</strong>.
            </p>
          </div>
        </div>

        <dl class="stats reveal" data-d="200">
          {stats.map((s) => (
            <div class="stat">
              <dt class="stat-label">{s.label}</dt>
              <dd class="stat-num"><span data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============================== WORK ============================== -->
    <section id="work" class="section">
      <div class="wrap">
        <header class="section-head">
          <div>
            <p class="label reveal"><span class="idx">02</span>Work</p>
            <h2 class="display reveal" data-d="80">Selected <em>case studies</em></h2>
          </div>
          <p class="mono count-tag reveal" data-d="160">[ {pad(work.length)} projects ]</p>
        </header>

        <ul class="work-grid">
          {work.map((entry, i) => (
            <li class={`work-item reveal ${i === 0 ? 'is-feature' : ''}`} data-d={String((i % 2) * 120)}>
              <a
                href={entry.data.slug === 'firstcry' ? '/firstcry-case-study.pdf' : `/work/${entry.data.slug}/`}
                target={entry.data.slug === 'firstcry' ? '_blank' : undefined}
                rel={entry.data.slug === 'firstcry' ? 'noopener' : undefined}
                class="card" data-tilt data-cursor="View"
              >
                <div class="card-inner">
                  <div class="card-media">
                    <Image
                      src={entry.data.heroImage}
                      alt=""
                      widths={[480, 800, 1200]}
                      sizes="(max-width: 860px) 100vw, 50vw"
                      loading={i < 2 ? 'eager' : 'lazy'}
                    />
                    <span class="card-platform">{entry.data.platform === 'web' ? 'Web' : 'Mobile'}</span>
                  </div>
                  <div class="card-body">
                    <div class="card-meta">
                      <span>{pad(i + 1)}</span>
                      <span class="card-meta-line" aria-hidden="true"></span>
                      <span>{entry.data.year}</span>
                    </div>
                    <p class="card-company">{entry.data.company}</p>
                    <h3 class="card-title">{entry.data.title}</h3>
                    <p class="card-summary">{entry.data.summary}</p>
                    <span class="card-link">
                      View case study
                      <span class="arrow-circle" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12L12 4M5 4h7v7" /></svg>
                      </span>
                    </span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============================== SKILLS ============================== -->
    <section id="skills" class="section">
      <div class="wrap">
        <header class="section-head">
          <div>
            <p class="label reveal"><span class="idx">03</span>Skills &amp; Tools</p>
            <h2 class="display reveal" data-d="80">What I bring <em>to the table.</em></h2>
          </div>
        </header>

        <div class="cap-grid">
          {capabilities.map((c, i) => (
            <article class="cap reveal" data-d={String(i * 110)} data-spot>
              <div class="cap-head">
                <h3>{c.title}</h3>
                <span class="mono">{c.note}</span>
              </div>
              <ul class="chips">
                {c.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================== RESUME ============================== -->
    <section id="resume" class="section">
      <div class="wrap">
        <header class="section-head">
          <div>
            <p class="label reveal"><span class="idx">04</span>Résumé</p>
            <h2 class="display reveal" data-d="80">Experience &amp; <em>education</em></h2>
            <p class="section-sub reveal" data-d="140">In-house product teams and independent work across web and mobile.</p>
          </div>
          <a href="/resume.pdf" class="btn btn-ghost btn-sm reveal" data-d="200" data-magnetic>
            <span class="btn-label">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2v9M4 7l4 4 4-4M3 14h10" /></svg>
              Download résumé (PDF)
            </span>
          </a>
        </header>

        <div class="timeline-grid">
          <div>
            <h3 class="col-title reveal">Experience</h3>
            <ol class="timeline">
              {experience.map((e, i) => (
                <li class="entry reveal" data-d={String(i * 90)}>
                  <div class="entry-top">
                    <p class="entry-role">{e.role}</p>
                    <p class="entry-date">{e.dates}</p>
                  </div>
                  <p class="entry-org">{e.org}</p>
                  {e.note && <p class="entry-note">{e.note}</p>}
                </li>
              ))}
            </ol>
          </div>
          <div>
            <h3 class="col-title reveal">Education</h3>
            <ol class="timeline">
              {education.map((e, i) => (
                <li class="entry reveal" data-d={String(i * 90)}>
                  <div class="entry-top">
                    <p class="entry-role">{e.credential}</p>
                    <p class="entry-date">{e.dates}</p>
                  </div>
                  <p class="entry-org">{e.org}</p>
                  {e.note && <p class="entry-note">{e.note}</p>}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== CONTACT ============================== -->
    <section id="contact" class="section contact">
      <div class="contact-glow" aria-hidden="true"></div>
      <div class="wrap contact-inner">
        <p class="label reveal"><span class="idx">05</span>Contact</p>
        <h2 class="contact-title">
          <span class="line-mask reveal-mask"><span>Let's build something</span></span>
          <span class="line-mask reveal-mask" data-d="120"><span><em class="grad">remarkable.</em></span></span>
        </h2>
        <p class="contact-lede reveal" data-d="200">
          Open to new roles and collaborations in enterprise product design. I usually reply within a day.
        </p>
        <ul class="contact-list">
          {contacts.map((c, i) => (
            <li class="reveal" data-d={String(240 + i * 90)}>
              <a class="contact-row" href={c.href} data-spot target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined}>
                <span class="contact-label">{c.label}</span>
                <span class="contact-value">{c.value}</span>
                <span class="arrow-circle" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12L12 4M5 4h7v7" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>
